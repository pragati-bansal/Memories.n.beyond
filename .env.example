# Supabase Configuration (Optional for Cloud DB & Storage)
# Leave blank to run in local mock mode
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# WhatsApp Business Order Phone Number (Country Code + 10 digits without '+' or spaces)
VITE_WHATSAPP_NUMBER=91******

# Admin Portal Passcode
VITE_ADMIN_PIN=admin123

# Admin email whitelist — only this address can log into the admin dashboard via Supabase Auth
VITE_ADMIN_EMAIL=your-email@example.com
